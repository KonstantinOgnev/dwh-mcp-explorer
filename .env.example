
# PostgreSQL connection settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=your_readonly_user
PGPASSWORD=replace_with_your_password

# Databricks authentication is configured separately
# through the MARKETPLACE_LAB profile in ~/.databrickscfg
# Databricks SQL Warehouse configuration
# Replace with your own SQL Warehouse ID
DATABRICKS_WAREHOUSE_ID=your_warehouse_id